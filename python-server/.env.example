PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Your Plivo number (E.164) used as Caller ID for outbound calls
PLIVO_PHONE_NUMBER=

# LiveKit Cloud — used for incoming calls via SIP / WebRTC
# Get these from https://cloud.livekit.io → your project → Settings
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# Public HTTPS URL of this service (required on Cloud Run / behind proxies)
# Example: https://mantra-voice-xxxxx.run.app
PUBLIC_BASE_URL=
# Optional override for the media WebSocket (defaults to wss://<PUBLIC_BASE_URL>/ws/plivo)
PUBLIC_WS_URL=

# Cloud Run sets PORT automatically; default for local is 8000
PORT=8000



MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=mantra_voice_agent

REDIS_URL=redis://localhost:6379



VOICE_MODE=gemini_realtime
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_VOICE_NAME=Erinome
GEMINI_LANGUAGE=en-US



DEEPGRAM_API_KEY=



ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5



CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.5
CARTESIA_VOICE_ID=e00d0e4c-a5c8-443f-a8a3-473eb9a62355



ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
